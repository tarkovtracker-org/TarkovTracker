{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "#imports": ["./src/shims/nuxt-imports.ts"],
      "@/*": ["../../app/*"],
      "~/*": ["../../app/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
